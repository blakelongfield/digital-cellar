# Digital Cellar — copy to .env and fill in values

# Transcription (Next.js): OpenAI Whisper. Required for real transcription.
OPENAI_API_KEY=

# Grading backend (Next.js): when set, POST /api/grade proxies to this URL.
# Leave unset to use built-in rule-based grading only.
BACKEND_URL=http://localhost:8000

# AI judges (backend): Anthropic. When set, The Butcher and The Metronome use AI.
# Leave unset to use rule-based Butcher/Metronome only.
ANTHROPIC_API_KEY=

# Optional: Anthropic model (backend). Default: claude-sonnet-4-20250514
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
