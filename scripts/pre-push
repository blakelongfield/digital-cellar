#!/bin/sh

# Block direct pushes to main. Use a branch + pull request instead.
# Install: cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

remote="$1"
url="$2"

while read local_ref local_oid remote_ref remote_oid
do
  # Block if pushing to main
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "❌ Direct pushes to main are blocked."
    echo ""
    echo "Use a branch instead:"
    echo "  git checkout -b feature/your-feature-name"
    echo "  git push -u origin feature/your-feature-name"
    echo ""
    echo "Then open a Pull Request on GitHub."
    echo ""
    exit 1
  fi
done

exit 0
